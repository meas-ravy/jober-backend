generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(cuid())
  phone            String?           @unique
  email            String?           @unique
  name             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  jobSeekerProfile JobSeekerProfile?
  companyProfile   CompanyProfile?
  roles            UserRole[]
  oauthAccounts    OAuthAccount[]
  postedJobs       Job[]             @relation("PostedJobs")
  applications     JobApplication[]  @relation("JobApplications")
  follows          Follow[]          @relation("UserFollows")
  notifications    Notification[]
  deviceTokens     DeviceToken[]
}

model UserRole {
  userId    String
  role      RoleName
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)

  @@index([phone, expiresAt])
  @@index([phone, consumedAt])
  @@index([expiresAt])
}

model RevokedToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  reason    String?

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

model JobSeekerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  fullName    String
  dateOfBirth DateTime
  email       String   @unique
  avatarUrl   String?
  gender      Gender
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id           String @id @default(cuid())
  userId       String @unique
  name         String
  contactEmail String
  contactPhone String
  location     String
  description  String
  logoUrl      String

  // Reputation & Verification
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  verifiedBy    String?
  followerCount Int       @default(0)
  hireRating    Float     @default(0)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier  AdminUser? @relation("VerifiedCompanies", fields: [verifiedBy], references: [id])
  jobs      Job[]
  followers Follow[]   @relation("CompanyFollowers")
}

model AdminUser {
  id                String           @id @default(cuid())
  email             String           @unique
  passwordHash      String
  name              String?
  avatarUrl         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  reviewedJobs      Job[]
  verifiedCompanies CompanyProfile[] @relation("VerifiedCompanies")
  notifications     Notification[]
}

enum RoleName {
  Job_finder
  Recruiter
  Admin
}

enum Gender {
  Male
  Female
  Other
}

model OAuthAccount {
  id                   String        @id @default(cuid())
  userId               String
  provider             OAuthProvider
  providerId           String
  email                String
  name                 String?
  avatarUrl            String?
  providerAccessToken  String?       @db.Text
  providerRefreshToken String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

enum OAuthProvider {
  Google
  LinkedIn
}

model Job {
  id               String @id @default(cuid())
  recruiterId      String
  companyProfileId String

  // Basic Info (ALL REQUIRED)
  title       String
  description String      @db.Text
  location    String
  jobImageUrl String? // Specific image for this job post (Optional)
  category    JobCategory

  // Job Details (REQUIRED)
  employmentType  EmploymentType
  experienceLevel ExperienceLevel
  workArrangement WorkArrangement @default(OnSite)

  // Salary (REQUIRED - but can be "Negotiable")
  salaryType     SalaryType   @default(Range)
  salaryMin      Int?
  salaryMax      Int?
  salaryFixed    Int?
  salaryCurrency String       @default("USD")
  salaryPeriod   SalaryPeriod @default(Year)

  // Additional Details
  requirements     String  @db.Text
  responsibilities String  @db.Text
  benefits         String? @db.Text
  skills           String?

  // Application (DEADLINE REQUIRED)
  applicationDeadline DateTime
  positionsAvailable  Int      @default(1)

  // Status & Lifecycle
  status JobStatus @default(Draft)

  // Admin Approval
  rejectionReason String?   @db.Text
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?

  // Metadata
  viewCount        Int       @default(0)
  applicationCount Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  publishedAt      DateTime?
  closedAt         DateTime?

  // Relations
  recruiter      User             @relation("PostedJobs", fields: [recruiterId], references: [id], onDelete: Cascade)
  companyProfile CompanyProfile   @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  reviewer       AdminUser?       @relation(fields: [reviewedBy], references: [id])
  applications   JobApplication[]

  @@index([recruiterId])
  @@index([companyProfileId])
  @@index([status, publishedAt])
  @@index([category])
  @@index([employmentType])
  @@index([experienceLevel])
}

enum JobCategory {
  Technology
  Healthcare
  Finance
  Education
  Marketing
  Sales
  Engineering
  Design
  CustomerService
  HumanResources
  Operations
  Legal
  Construction
  Retail
  Hospitality
  Manufacturing
  Transportation
  RealEstate
  Media
  Other
}

enum EmploymentType {
  FullTime
  PartTime
  Contract
  Internship
  Freelance
}

enum ExperienceLevel {
  Entry
  Mid
  Senior
  Lead
  Executive
}

enum WorkArrangement {
  OnSite
  Remote
  Hybrid
}

enum SalaryType {
  Range
  Fixed
  Negotiable
}

enum SalaryPeriod {
  Hour
  Day
  Week
  Month
  Year
}

enum JobStatus {
  Draft
  Pending
  Rejected
  Active
  Paused
  Closed
  Filled
}

model JobApplication {
  id          String @id @default(cuid())
  jobId       String
  jobSeekerId String

  // Application Data
  resumeUrl   String // Cloudinary URL (required)
  coverLetter String? @db.Text

  // Status & Tracking
  status         ApplicationStatus @default(Submitted)
  recruiterNotes String?           @db.Text

  // Timestamps
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  // Relations
  job       Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobSeeker User @relation("JobApplications", fields: [jobSeekerId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([jobSeekerId, status])
  @@index([status])
  @@index([submittedAt])
}

enum ApplicationStatus {
  Submitted
  UnderReview
  Shortlisted
  Rejected
  Hired
  Withdrawn
}

model Follow {
  followerId       String
  companyProfileId String
  createdAt        DateTime @default(now())

  follower       User           @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  companyProfile CompanyProfile @relation("CompanyFollowers", fields: [companyProfileId], references: [id], onDelete: Cascade)

  @@id([followerId, companyProfileId])
  @@index([companyProfileId])
  @@index([followerId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String? // "iOS", "Android", "Web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String? // Recipient (Recruiter or Seeker)
  adminId   String? // Recipient (Admin)
  title     String
  content   String           @db.Text
  type      NotificationType
  link      String? // Deep link or URL
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([adminId])
  @@index([isRead])
}

enum NotificationType {
  // Common
  INFO
  SYSTEM

  // Recruiter specific
  NEW_APPLICATION
  VERIFICATION_STATUS
  JOB_STATUS_CHANGE

  // Job Seeker specific
  APPLICATION_UPDATE
  NEW_JOB_FROM_FOLLOW

  // Admin specific
  NEW_JOB_SUBMISSION
  NEW_VERIFICATION_REQUEST
}
